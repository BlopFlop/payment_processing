# Значения только для разработки — не использовать в проде.

APISERVICE_API_KEY=local-dev-api-key
APISERVICE_LOG_LEVEL=INFO
# APISERVICE_APP_TYPE задаётся в docker-compose для каждого сервиса (api | producer | consumer)

POSTGRES_USER=payment
POSTGRES_PASSWORD=payment
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=payment

RABBITMQ_USER=payment
RABBITMQ_PASSWORD=payment

BROKERSERVICE_URL=amqp://payment:payment@localhost:5672/
BROKERSERVICE_RETRY_MAX_ATTEMPTS=3
BROKERSERVICE_RETRY_BASE_DELAY=1.0
BROKERSERVICE_OUTBOX_POLL_INTERVAL=1.0
BROKERSERVICE_OUTBOX_BATCH_SIZE=100
BROKERSERVICE_WEBHOOK_TIMEOUT=10

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
