# Статический ключ для заголовка X-API-Key
APISERVICE_API_KEY=change-me

# PostgreSQL
POSTGRES_USER=payment
POSTGRES_PASSWORD=payment
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=payment

# RabbitMQ (используются docker-compose; внутри compose BROKERSERVICE_URL собирается из них)
RABBITMQ_USER=payment
RABBITMQ_PASSWORD=payment
# для локального запуска вне docker
BROKERSERVICE_URL=amqp://payment:payment@localhost:5672/

# Только для прода: домен сайта и email для уведомлений Let's Encrypt (email необязателен)
# DOMAIN=example.com
# CERTBOT_EMAIL=admin@example.com

# Необязательные настройки (значения по умолчанию)
# APISERVICE_LOG_LEVEL=INFO
# BROKERSERVICE_RETRY_MAX_ATTEMPTS=3      # всего попыток обработки, после — DLQ
# BROKERSERVICE_RETRY_BASE_DELAY=1.0      # задержка повтора: base * 2^n секунд
# BROKERSERVICE_OUTBOX_POLL_INTERVAL=1.0  # период опроса outbox, сек
# BROKERSERVICE_OUTBOX_BATCH_SIZE=100
# BROKERSERVICE_WEBHOOK_TIMEOUT=10
